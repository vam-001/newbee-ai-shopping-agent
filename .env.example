# 复制为 .env 后填入真实密钥（.env 已被 .gitignore 忽略）
# ===== AI 模型（必填一个支持 Function Calling 的 OpenAI 兼容接口） =====
AI_API_KEY=not-configured
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
# 公网部署建议设为 true：只允许登录用户使用 AI 导购
AI_REQUIRE_LOGIN=false

# 可选：DeepSeek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_CHAT_MODEL=deepseek-chat

# ===== 数据库（默认 127.0.0.1:3306，本地端口不同时覆盖） =====
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=newbee_mall_db
# DB_USERNAME=root
# DB_PASSWORD=

# ===== Redis（默认 127.0.0.1:6379） =====
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
